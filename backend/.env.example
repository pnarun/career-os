# MongoDB Atlas (cloud-hosted)
# Get this from Atlas: Database → Connect → Drivers → copy connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/career_os?retryWrites=true&w=majority

# Redis (local Docker default)
REDIS_URL=redis://localhost:6379/0

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Resend (real outbound email — use onboarding@resend.dev until domain verified)
RESEND_API_KEY=<resend_api_key>
RESEND_FROM_EMAIL=<resend_from_email>

# Cloudinary (resume storage)
CLOUDINARY_CLOUD_NAME=<cloudinary_cloud_name>
CLOUDINARY_API_KEY=<cloudinary_api_key>
CLOUDINARY_API_SECRET=<cloudinary_api_secret>
