# Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Production (Render) ---
# ENVIRONMENT=production
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ORIGINS=["https://your-app.vercel.app"]
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# AUTH_DEV_EXPOSE_OTP=false
# REDIS_ENABLED=false
# CELERY_ENABLED=false
# CRON_SECRET=<optional>  # only if using POST /internal/cron/scheduled-scans
# HEALTH_CACHE_SECONDS=2
# SCHEDULER_HEARTBEAT_ENABLED=true
# SCHEDULER_STARTUP_CATCHUP=true
CRON_SECRET=<long-random-string>

# Frontend origins (JSON array). FRONTEND_URL is merged automatically in production.
# CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# MongoDB Atlas (cloud-hosted)
# Get this from Atlas: Database → Connect → Drivers → copy connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/career_os?retryWrites=true&w=majority

REDIS_URL=<redis_url>
REDIS_ENABLED=<true or false>

# Infrastructure
CELERY_ENABLED=<true or false>
QUEUE_SCANS_ENABLED=<true or false>
RATE_LIMIT_ENABLED=<true or false>

# Google Gemini
GEMINI_API_KEY=<your_gemini_api_key>

# Frontend URL
FRONTEND_URL=https://career-os-two-chi.vercel.app

# Resend (real outbound email — use onboarding@resend.dev until domain verified)
RESEND_API_KEY=<resend_api_key>
RESEND_FROM_EMAIL=<resend_from_email>

# Ops alerts: new signups, deploy webhooks (same inbox for GitHub Actions secrets)
ADMIN_NOTIFY_EMAIL=<your_email@example.com>
ADMIN_NOTIFY_ENABLED=true

# Cloudinary (resume storage)
CLOUDINARY_CLOUD_NAME=<cloudinary_cloud_name>
CLOUDINARY_API_KEY=<cloudinary_api_key>
CLOUDINARY_API_SECRET=<cloudinary_api_secret>

# Optional brand CDN (run: python scripts/upload_brand_logos.py)
# Email logos — run: python scripts/upload_brand_logos.py (Cloudinary, best for Gmail)
# BRAND_LOGO_FULL_URL=
# BRAND_LOGO_BLACK_URL=
# BRAND_LOGO_SYMBOL_URL=
# Direct PNG route for emails (do not use Vercel SPA URL for images)
API_PUBLIC_URL=https://career-os-pd9g.onrender.com

# JWT authentication (use a long random secret in production)
JWT_SECRET_KEY=change-me-in-production-use-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Legacy data migration (first startup assigns orphan data to this user)
LEGACY_MIGRATION_EMAIL=<add your email if you want to migrate legacy data>
LEGACY_MIGRATION_PASSWORD=<add your password if you want to migrate legacy data>

# Dev: expose OTP in API when Resend is unavailable (local dev only)
AUTH_DEV_EXPOSE_OTP=<true or false>

# Google OAuth (extension point)
GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>
GOOGLE_OAUTH_REDIRECT_URI=<google_oauth_redirect_uri>

PLAYWRIGHT_HEADLESS=<true or false>
PLAYWRIGHT_SLOW_MO=<0 or any number>
PLAYWRIGHT_VIEWPORT_WIDTH=<1280 or any number>
PLAYWRIGHT_VIEWPORT_HEIGHT=<720 or any number>
PLAYWRIGHT_DEFAULT_TIMEOUT_MS=<30000 or any number>

# Upstash Redis (response caching — see docs/performance/redis-caching.md)
UPSTASH_REDIS_REST_URL=<upstash_redis_rest_url>
UPSTASH_REDIS_REST_TOKEN=<upstash_redis_rest_token>
CACHE_RESPONSE_TTL=300

# MongoDB performance (optional)
MONGO_SLOW_QUERY_MS=500
MONGO_EXPLAIN_QUERIES=false
MONGO_ANALYTICS_HISTORY_LIMIT=1500

# Provider resilience & observability
PROVIDER_FETCH_TIMEOUT_SECONDS=90
PROVIDER_FETCH_MAX_RETRIES=1
API_SLOW_REQUEST_MS=1500
SCAN_STALE_SECONDS=7200

# Beta / Career Lens extension
EXTENSION_MIN_VERSION=0.3.0
WEBSOCKET_MAX_CONNECTIONS_PER_USER=5
WEBSOCKET_MAX_CONNECTIONS_TOTAL=200