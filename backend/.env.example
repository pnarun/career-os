# Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Production (Render) ---
# ENVIRONMENT=production
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ORIGINS=["https://your-app.vercel.app"]
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# AUTH_DEV_EXPOSE_OTP=false
# REDIS_ENABLED=false
# CELERY_ENABLED=false

# Frontend origins (JSON array). FRONTEND_URL is merged automatically in production.
# CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# MongoDB Atlas (cloud-hosted)
# Get this from Atlas: Database → Connect → Drivers → copy connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/career_os?retryWrites=true&w=majority

REDIS_URL=<redis_url>
REDIS_ENABLED=<true or false>

# Infrastructure
CELERY_ENABLED=<true or false>
QUEUE_SCANS_ENABLED=<true or false>
RATE_LIMIT_ENABLED=<true or false>

# Google Gemini
GEMINI_API_KEY=<your_gemini_api_key>

# Resend (real outbound email — use onboarding@resend.dev until domain verified)
RESEND_API_KEY=<resend_api_key>
RESEND_FROM_EMAIL=<resend_from_email>

# Cloudinary (resume storage)
CLOUDINARY_CLOUD_NAME=<cloudinary_cloud_name>
CLOUDINARY_API_KEY=<cloudinary_api_key>
CLOUDINARY_API_SECRET=<cloudinary_api_secret>

# JWT authentication (use a long random secret in production)
JWT_SECRET_KEY=change-me-in-production-use-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Legacy data migration (first startup assigns orphan data to this user)
LEGACY_MIGRATION_EMAIL=<add your email if you want to migrate legacy data>
LEGACY_MIGRATION_PASSWORD=<add your password if you want to migrate legacy data>

# Dev: expose OTP in API when Resend is unavailable (local dev only)
AUTH_DEV_EXPOSE_OTP=<true or false>

# Google OAuth (extension point)
GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>
GOOGLE_OAUTH_REDIRECT_URI=<google_oauth_redirect_uri>

PLAYWRIGHT_HEADLESS=<true or false>
PLAYWRIGHT_SLOW_MO=<0 or any number>
PLAYWRIGHT_VIEWPORT_WIDTH=<1280 or any number>
PLAYWRIGHT_VIEWPORT_HEIGHT=<720 or any number>
PLAYWRIGHT_DEFAULT_TIMEOUT_MS=<30000 or any number>
