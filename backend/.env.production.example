# Production template for Render (set in Render Dashboard → Environment).
# Copy values into the dashboard; do not commit a filled .env.production file.

ENVIRONMENT=production
LOG_LEVEL=INFO

FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=["https://your-app.vercel.app"]
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/career_os?retryWrites=true&w=majority

JWT_SECRET_KEY=<long-random-secret>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_ENABLED=false
CELERY_ENABLED=false
QUEUE_SCANS_ENABLED=false
RATE_LIMIT_ENABLED=true

GEMINI_API_KEY=<gemini_key>
RESEND_API_KEY=<resend_key>
RESEND_FROM_EMAIL=<verified@yourdomain.com>

CLOUDINARY_CLOUD_NAME=<name>
CLOUDINARY_API_KEY=<key>
CLOUDINARY_API_SECRET=<secret>

PLAYWRIGHT_HEADLESS=true
AUTH_DEV_EXPOSE_OTP=false
AUTH_SEED_DEMO_USERS=false

# Optional OAuth (update redirect URI to your Render URL + auth callback path)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://your-api.onrender.com/auth/google/callback
