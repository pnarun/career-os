# Copy to .env for local dev (gitignored):
#   cp .env.example .env
#
# Vercel: set the same keys in Project → Settings → Environment Variables
# (Production + Preview). Rebuild after changing VITE_* vars.

# --- Local (default) ---
VITE_API_BASE_URL=http://127.0.0.1:8001
# WebSocket base (optional — derived from API URL if omitted)
# VITE_WS_BASE_URL=ws://127.0.0.1:8001

# --- Production example (Render backend) ---
# VITE_API_BASE_URL=https://career-os-api.onrender.com
# VITE_WS_BASE_URL=wss://career-os-api.onrender.com

# Feature flags
# VITE_ASSISTED_APPLY_ENABLED=false
